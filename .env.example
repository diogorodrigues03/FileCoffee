# Copy to .env (next to docker-compose.yml) before running `docker compose up`.
# docker compose reads this file automatically. Never commit the real .env.

# Shared secret between the backend and coturn, used to sign short-lived TURN
# credentials. Required for docker-compose.yml (production); the dev compose
# file falls back to an insecure development value if unset.
#
# Use only letters, digits and _ - . + / = : the coturn image's entrypoint passes arguments
# through `eval`, so shell characters like $ ` ; ' " would break or be executed.
# Generate one with:  openssl rand -hex 32
TURN_SECRET=

# TURN realm (usually your domain)
TURN_REALM=localhost
