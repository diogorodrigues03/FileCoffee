# Copy to backend/.env for `cargo run`. Never commit the real .env.

# Log level / filter for tracing (e.g. info, debug, backend=debug)
RUST_LOG=info

# TURN server used for relaying when peers can't connect directly.
# Leave TURN_URL/TURN_SECRET unset to use STUN only.
TURN_URL=turn:127.0.0.1:3478
# Must match coturn's --static-auth-secret. Letters, digits and _ - . + / = only.
# Generate with:  openssl rand -hex 32
TURN_SECRET=
TURN_REALM=localhost

# Optional overrides (defaults shown)
# PORT=3030
# TURN_CREDENTIAL_TTL_SECS=7200
# ROOM_MAX_PASSWORD_ATTEMPTS=5
# PASSWORD_MAX_LEN=256
# ARGON2_MAX_CONCURRENT=<number of CPUs, capped at 8>

# Rate limits (per client IP, or per IPv6 /64)
# RATE_LIMIT_RPM=60               # HTTP API requests per minute
# WS_CONNECTIONS_PER_MINUTE=30    # new WebSocket connections per minute
# WS_MAX_CONNECTIONS_PER_IP=20    # WebSocket connections open at once
# ROOMS_PER_MINUTE=10             # rooms created per minute
# JOINS_PER_MINUTE=20             # join attempts (password guesses) per minute
# WS_MESSAGES_PER_SEC=20          # sustained messages per WebSocket
# WS_MESSAGE_BURST=100            # message burst per WebSocket
# WS_MAX_MESSAGE_SIZE=65536       # bytes; larger messages close the connection
# MAX_ROOMS=10000                 # rooms in memory across all clients
#
# IMPORTANT behind a reverse proxy / load balancer: set this to the number of
# proxies that append to X-Forwarded-For (usually 1). Otherwise every client
# shares the proxy's IP and its limits. Leave 0 when clients connect directly,
# or the header can be spoofed to dodge limits.
# TRUSTED_PROXY_HOPS=0
